generator client {
  provider = "prisma-client-js" 
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model - for authentidcation and author info
model User {
  id        String   @id @default(cuid())  
  email     String   @unique             
  username  String   @unique
  name String                       
  age       Int                  
  createdAt DateTime @default(now())     
}