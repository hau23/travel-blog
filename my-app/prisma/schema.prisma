generator client {
  provider = "prisma-client-js" 
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model - for authentidcation and author info
model User {
  id        String   @id @default(cuid())  
  email     String   @unique             
  username  String   @unique
  name String                       
  age       Int                  
  createdAt DateTime @default(now())     

  posts Post[]
  comment Comment[]

  @@map("users")
}

// Post model - for blog posts/travel stories
model Post {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  excerpt     String?     @db.Text
  content     String      @db.Text
  coverImage  String?     // URL to cover image
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  viewCount   Int         @default(0)
  
  // Travel-specific fields
  location    String?
  country     String?
  travelDate  DateTime?
  duration    String?     // "5 days", "2 weeks", etc.
  budget      Float?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?

  // Relations
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  images      PostImage[]

  @@map("posts")
}


// Comment model - for user interactions
model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  // For threaded comments (replies)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  parentId  String?
  replies   Comment[] @relation("CommentReplies")

  @@map("comments")
}

// PostImage model - for multiple images per post
model PostImage {
  id          String   @id @default(cuid())
  url         String
  alt         String?
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  // Relations
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String

  @@map("post_images")
}